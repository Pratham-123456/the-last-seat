# Copy to .env and replace CHANGE_ME with the password you choose for the
# project role. scripts/bootstrap_local_db.ps1 reads it from here to create the role.
# .env is gitignored - never commit real credentials.
DATABASE_URL=postgresql+psycopg://last_seat_app:CHANGE_ME@localhost:5432/last_seat_db
TEST_DATABASE_URL=postgresql+psycopg://last_seat_app:CHANGE_ME@localhost:5432/last_seat_test_db

# Seconds a seat stays HELD before it expires (use e.g. 30 for a live demo)
HOLD_TTL_SECONDS=300
EXPIRY_WORKER_INTERVAL_SECONDS=5
EXPIRY_WORKER_BATCH_SIZE=100

# Connection pool per API process, and max concurrent request threads per process
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
API_THREAD_LIMIT=50
